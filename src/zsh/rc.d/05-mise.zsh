#------------------------------------------------------------------------------
# mise の有効化
#
# ここが 05（早い番号）にあるのは意図的。
# mise 管理のツール（peco / ghq など）は activate するまで PATH に現れないため、
# 40-alias.zsh のように `which <cmd>` で存在を確認してから alias を定義する
# ファイルより先に実行しないと、コマンドは入っているのに alias が定義されない。
#
# 20-completion.zsh の compinit より前でもある（mise が fpath に補完を足す場合に効く）。
#------------------------------------------------------------------------------

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi
