#------------------------------------------------------------------------------
# .zshrc  ->  ~/.zshrc
#
# 対話シェル用の設定。実体は ~/.config/zsh/rc.d/*.zsh に分割してあり、
# このファイルはそれを番号順に読み込むだけ。
#------------------------------------------------------------------------------

# macOS の /etc/zprofile が path_helper で PATH 順序を壊すため、ここで再構築する。
# (定義は ~/.zshenv)
(( $+functions[__dotfiles_path_init] )) && __dotfiles_path_init

#------------------------------------------------------------------------------
# rc.d の読み込み
#------------------------------------------------------------------------------
ZSH_RC_D="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/rc.d"

if [[ -d $ZSH_RC_D ]]; then
  for __rc in "$ZSH_RC_D"/*.zsh(N.); do
    source "$__rc"
  done
  unset __rc
fi
unset ZSH_RC_D

#------------------------------------------------------------------------------
# このマシン固有の設定（リポジトリ管理外）
#------------------------------------------------------------------------------
# `[[ ... ]] && source` と書くとファイルが無いとき終了ステータスが 1 になり、
# rc 読み込み直後の $? が 1 のままになる（プロンプトの %(?..) が赤くなる）。
# 最後に必ず 0 で終わるように if で書く。
if [[ -f $HOME/.zshrc.local ]]; then
  source "$HOME/.zshrc.local"
fi

# rc の読み込み自体の結果でプロンプトの成否表示が汚れないようにする
true
