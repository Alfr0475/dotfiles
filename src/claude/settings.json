{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/usage-limits"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "mcp__multi-account-mcp__list_accounts",
      "mcp__multi-account-mcp__drive_search",
      "mcp__multi-account-mcp__drive_read",
      "mcp__multi-account-mcp__sheets_read",
      "Bash(~/.claude/hooks/session-title:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/curl -m 1 -sf -o /dev/null -X POST http://127.0.0.1:7788/api/hooks/claude -H 'content-type: application/json' --data-binary @- || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/session-title\" --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/curl -m 1 -sf -o /dev/null -X POST http://127.0.0.1:7788/api/hooks/claude -H 'content-type: application/json' --data-binary @- || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/curl -m 1 -sf -o /dev/null -X POST http://127.0.0.1:7788/api/hooks/claude -H 'content-type: application/json' --data-binary @- || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/curl -m 1 -sf -o /dev/null -X POST http://127.0.0.1:7788/api/hooks/claude -H 'content-type: application/json' --data-binary @- || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/curl -m 1 -sf -o /dev/null -X POST http://127.0.0.1:7788/api/hooks/claude -H 'content-type: application/json' --data-binary @- || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "effortLevel": "high"
}
