#!/usr/bin/python3
"""セッション名を「目的 ／ 今の段階」の形に保つための hook とコマンド。

名前を考えるのはセッションの中の Claude 自身。この 1 本は次の 2 役を持つ。

  session-title --hook
      UserPromptSubmit hook。毎ターン、今の名前・同じリポジトリの最近の
      セッション名・名前の変え方を Claude に短く知らせる。規則そのものは
      ~/.claude/CLAUDE.md の「セッション名」に書いてある。
      人が付けた名前のセッションでは何も知らせない。

  session-title "<新しい名前>"
      CLI・VSCode 拡張のセッションで、Claude が Bash から呼んで名前を変える。
      transcript に custom-title を書き足す。

  session-title --self-test
      判定と書式の自己検査。make doctor から呼ぶ。

デスクトップアプリのセッションでは、名前の正本はアプリにある。transcript に
書いても次のターンでアプリに書き直されるので、Claude にはアプリのツール
（set_session_title）で変えさせ、このコマンドは使わせない。

CLI・VSCode の名前の正本は Claude Code のメモリ（currentSessionTitle）。
Claude Code は毎ターン・終了時にその値を印なしの custom-title で transcript に
書き足し直す。書き足す前に末尾の custom-title を読み直してメモリを合わせるが、
拾うのは '"type":"custom-title"' と '"customTitle":"' を含む行だけ。
だからこのコマンドは空白なしの JSON で書く（空白入りだと読み直されず、
メモリの古い名前で上書きされる）。

人が付けた名前の見分け方:
  名前を最後に付けたのが自分（CLI・VSCode はこのコマンド、デスクトップは
  Claude の set_session_title 呼び出し）で、今の名前がそれと同じなら自動の名前。
  違えば、基本は人が付けた名前。ただし次の名前は「古い名前」として付け直す。
    - /clear 前から持ち越した名前（/clear で session ID は変わるが、Claude Code が
      メモリの名前を新しい transcript の先頭に書き写す）
    - 最後にこのコマンドで書く前に出ていた名前が、印なしで再び出てきたもの
      （Claude Code のメモリに残った古い名前の書き戻し）
  人が /rename で以前と同じ名前に戻した場合は見分けられない（受け入れている）。

設計の経緯は ideas-vault の inbox/202611-セッション名の自動リネーム.md。
"""

import glob
import json
import os
import sys

SOURCE = "session-title"           # このコマンドが書く custom-title の印
MAX_TITLE = 80
SIBLINGS = 10                      # 知らせに載せる同じリポジトリのセッション数
TAIL_BYTES = 65536                 # 一覧が読むのは transcript の先頭と末尾 64KB
REFRESH_MARGIN = 32768             # 名前がこれ以上末尾から離れたら書き直す
DESKTOP_TOOL = "mcp__ccd_session_mgmt__set_session_title"
CLEAR_MARK = "<command-name>/clear</command-name>"
INTERACTIVE = ("cli", "claude-vscode", "claude-desktop")


def claude_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def is_desktop():
    return os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop"


#------------------------------------------------------------------
# transcript の読み取り
#------------------------------------------------------------------

def scan(path):
    """transcript から名前に関わる記録を拾う。

    返す dict:
      last       最後の custom-title の名前
      last_end   その行の終わりの位置（末尾からの距離を測るため）
      ours       このコマンドが最後に付けた名前（旧 session-retitle.sh の記録も含む）。
                 /clear で消す（/clear 前の会話の名前なので付け直す）
      stale      古い名前の集合。目印（このコマンドの書き込みか /clear）の時点
                 までに出ていた名前。印なしでこれに戻ったら、人ではなく
                 Claude Code のメモリからの書き戻し
      cleared    最後の目印が /clear か
      desktop    Claude が set_session_title で最後に付けた名前
      size       ファイルの大きさ
    """
    info = {"last": None, "last_end": None, "ours": None, "desktop": None,
            "stale": set(), "cleared": False, "size": 0}
    seen = set()
    try:
        fh = open(path, "rb")
    except OSError:
        return info
    with fh:
        pos = 0
        for raw in fh:
            pos += len(raw)
            # 全行を JSON として読むと数 MB で遅いので、関係する行だけ読む
            if (b"custom-title" not in raw and DESKTOP_TOOL.encode() not in raw
                    and CLEAR_MARK.encode() not in raw):
                continue
            try:
                entry = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            if entry.get("type") == "custom-title":
                title = entry.get("customTitle")
                if not isinstance(title, str):
                    continue
                info["last"] = title
                info["last_end"] = pos
                # 旧 session-retitle.sh は uuid と timestamp を付けて書いていた
                if entry.get("source") == SOURCE or ("uuid" in entry and "timestamp" in entry):
                    info["ours"] = title
                    info["stale"] = seen - {title}
                    info["cleared"] = False
                seen.add(title)
            elif entry.get("type") == "user" and is_clear(entry):
                info["ours"] = None
                info["stale"] = set(seen)
                info["cleared"] = True
            elif entry.get("type") == "assistant":
                for block in (entry.get("message") or {}).get("content") or []:
                    if (isinstance(block, dict) and block.get("type") == "tool_use"
                            and block.get("name") == DESKTOP_TOOL):
                        args = block.get("input") or {}
                        if args.get("session_id") == "self" and isinstance(args.get("title"), str):
                            info["desktop"] = args["title"]
        info["size"] = pos
    return info


def is_clear(entry):
    """ユーザーが打った /clear の記録か。

    コマンドの記録は content が文字列で、先頭が <command-name>/clear</command-name>。
    tool_result（content がリスト）や会話中の引用に同じ文字列があっても拾わない。
    """
    content = (entry.get("message") or {}).get("content")
    return isinstance(content, str) and content.lstrip().startswith(CLEAR_MARK)


def is_stale(info):
    """今の名前が、付け直すべき古い名前か（/clear 前の名前、または書き戻し）。"""
    return info["last"] is not None and info["last"] != info["ours"] and info["last"] in info["stale"]


def is_human(info):
    """今の名前が人の付けた名前か。"""
    return info["last"] is not None and info["last"] != info["ours"] and not is_stale(info)


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def desktop_title(transcript):
    """デスクトップアプリの名前。アプリはこのファイルを正本に合わせて書く。"""
    data = read_json(os.path.join(transcript[:-len(".jsonl")], "custom-title.json"))
    if isinstance(data, dict) and isinstance(data.get("customTitle"), str):
        return data["customTitle"]
    return None


def tail_title(path):
    """一覧と同じ順（transcript の末尾 → custom-title.json）で今の名前を返す。

    custom-title.json は /rename と /clear のときにしか書かれず古いことがあるので、
    末尾に名前があればそちらを使う。
    """
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - TAIL_BYTES))
            chunk = fh.read()
    except OSError:
        return None
    custom = ai = None
    for raw in chunk.splitlines():
        if b"-title" not in raw:
            continue
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(entry, dict):
            continue
        if entry.get("type") == "custom-title":
            custom = entry.get("customTitle")
        elif entry.get("type") == "ai-title":
            ai = entry.get("aiTitle")
    if custom:
        return custom
    data = read_json(os.path.join(path[:-len(".jsonl")], "custom-title.json"))
    if isinstance(data, dict) and isinstance(data.get("customTitle"), str):
        return data["customTitle"]
    return ai


def siblings(transcript):
    """同じリポジトリの最近のセッション名（自分を除く）。"""
    here = os.path.abspath(transcript)
    files = [f for f in glob.glob(os.path.join(os.path.dirname(here), "*.jsonl"))
             if os.path.abspath(f) != here]
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    names = []
    for f in files:
        title = tail_title(f)
        if title and title not in names:
            names.append(title)
        if len(names) >= SIBLINGS:
            break
    return names


def title_line(session_id, title):
    entry = {"type": "custom-title", "customTitle": title,
             "sessionId": session_id, "source": SOURCE}
    # 空白なしで書く。Claude Code は '"type":"custom-title"' を含む行しか
    # 読み直さないので、空白入りだとメモリの古い名前で上書きされる
    return json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n"


def append_title(transcript, session_id, title):
    # O_APPEND への 1 回の write なので、実行中のセッションの追記と混ざらない
    with open(transcript, "a", encoding="utf-8") as fh:
        fh.write(title_line(session_id, title))


#------------------------------------------------------------------
# hook
#------------------------------------------------------------------

def hook():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(payload, dict):
        return
    # claude -p などの非対話の実行では名前を付けない
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT") not in INTERACTIVE:
        return

    session_id = payload.get("session_id")
    transcript = payload.get("transcript_path")
    if not session_id or not transcript or not os.path.exists(transcript):
        return

    info = scan(transcript)

    if is_desktop():
        current = desktop_title(transcript) or info["last"]
        # Claude が付けた名前から変わっていたら、人がサイドバーで付け直した
        if info["desktop"] and current != info["desktop"]:
            return
        # Claude がまだ付けていない名前は、アプリが付けた仮の名前として扱う
        shown = info["desktop"]
        how = ("`%s` を session_id \"self\" で呼んで変える"
               "（読み込まれていなければ ToolSearch で select:%s）" % (DESKTOP_TOOL, DESKTOP_TOOL))
    else:
        current = info["last"]
        stale = is_stale(info)
        # このコマンドが付けておらず、古い名前でもない custom-title は、人が /rename などで付けた名前
        if is_human(info):
            return
        # 一覧は末尾 64KB しか読まないので、離れたら同じ名前を書き直す（モデルは呼ばない）
        # 古い名前は付け直してもらうので、印付きで書き直して固定しない
        if not stale and current and info["size"] - info["last_end"] > REFRESH_MARGIN:
            append_title(transcript, session_id, current)
        shown = current
        how = 'Bash で `~/.claude/hooks/session-title "<新しい名前>"` を実行して変える'

    if not is_desktop() and stale:
        why = "/clear 前の会話から引き継いだ名前" if info["cleared"] else "Claude Code が書き戻した古い名前"
        state = "「%s」（%s。今の会話の内容でこのターンで必ず付け直す）" % (shown, why)
    elif shown:
        state = "「%s」" % shown
    else:
        state = "未設定（このターンで必ず付ける）"
    lines = ["[セッション名] 今の名前: %s" % state]
    names = siblings(transcript)
    if names:
        lines.append("同じリポジトリの最近のセッション（これらと区別できる名前にする）:")
        lines.extend("- %s" % n for n in names)
    lines.append("返答を書き終えたら、CLAUDE.md の「セッション名」の規則で名前を見直し、"
                 "変えるときは%s。変える必要がなければ何もせず、このことに返答で触れない。" % how)

    json.dump({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                      "additionalContext": "\n".join(lines)}},
              sys.stdout, ensure_ascii=False)


#------------------------------------------------------------------
# コマンド
#------------------------------------------------------------------

def die(msg):
    sys.stderr.write("session-title: %s\n" % msg)
    sys.exit(1)


def command(args):
    title = " ".join(" ".join(args).split())
    if not title:
        die('使い方: session-title "<新しい名前>"')
    if len(title) > MAX_TITLE:
        die("名前が長すぎる（%d 文字まで）" % MAX_TITLE)
    if is_desktop():
        die("デスクトップアプリのセッションでは %s を使う（transcript に書いてもアプリに戻される）" % DESKTOP_TOOL)

    session_id = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session_id:
        die("CLAUDE_CODE_SESSION_ID が無い。Claude Code のセッションの中から実行する")
    found = glob.glob(os.path.join(claude_dir(), "projects", "*", "%s.jsonl" % session_id))
    if not found:
        die("このセッションの transcript が見つからない: %s" % session_id)
    transcript = found[0]

    info = scan(transcript)
    if is_human(info):
        die("人が付けた名前「%s」なので変えない" % info["last"])
    if info["last"] == title:
        print("変更なし: %s" % title)
        return
    append_title(transcript, session_id, title)
    print("セッション名を変えた: %s" % title)


#------------------------------------------------------------------
# 自己検査（make doctor から呼ぶ）
#------------------------------------------------------------------

def self_test():
    """実際に起きた並びを再現した transcript で、判定と書式を確かめる。"""
    import tempfile

    sid = "00000000-0000-0000-0000-000000000000"

    def cc(title):      # Claude Code 本体がメモリから書き足す行
        return json.dumps({"type": "custom-title", "customTitle": title, "sessionId": sid},
                          ensure_ascii=False, separators=(",", ":")) + "\n"

    def legacy(title):  # 空白入りの書式で書いていた頃のこのコマンドの行
        return json.dumps({"type": "custom-title", "customTitle": title,
                           "sessionId": sid, "source": SOURCE}, ensure_ascii=False) + "\n"

    def clear():
        return json.dumps({"type": "user", "message": {"role": "user", "content":
                           CLEAR_MARK + "\n<command-message>clear</command-message>"}}) + "\n"

    def ours(title):
        return title_line(sid, title)

    # (名前, 行, 期待: "ours" / "stale" / "human" / "none")
    cases = [
        ("名前なし", [], "none"),
        ("このコマンドの名前", [ours("A"), cc("A")], "ours"),
        ("人の /rename", [ours("A"), cc("A"), cc("H")], "human"),
        # /clear: 新しい transcript の先頭に前の名前が持ち越される（a529dd37 の 0〜5 行目）
        ("/clear で持ち越した名前", [cc("OLD"), clear(), cc("OLD")], "stale"),
        ("/clear 前に自分が付けた名前", [ours("A"), clear(), cc("A")], "stale"),
        ("/clear 後の人の /rename", [cc("OLD"), clear(), cc("H")], "human"),
        ("/clear 後に付け直した名前", [cc("OLD"), clear(), ours("NEW"), cc("NEW")], "ours"),
        # 付け直した後にメモリの古い名前が書き戻された（a529dd37 の 744→761 行目）
        ("/clear 後の書き戻し", [cc("OLD"), clear(), legacy("NEW"), cc("OLD")], "stale"),
        # resume で読んだ名前の書き戻し（db6a6291 の 958→978 行目）
        ("resume 後の書き戻し", [legacy("A"), legacy("B"), cc("B"), legacy("C"), cc("B")], "stale"),
        ("書き戻しの後の人の /rename", [ours("A"), ours("B"), cc("A"), cc("H")], "human"),
    ]

    failed = 0
    tmp = tempfile.mkdtemp(prefix="session-title-")
    try:
        for i, (name, lines, want) in enumerate(cases):
            path = os.path.join(tmp, "%d.jsonl" % i)
            with open(path, "w", encoding="utf-8") as fh:
                fh.writelines(lines)
            info = scan(path)
            if info["last"] is None:
                got = "none"
            elif is_stale(info):
                got = "stale"
            elif is_human(info):
                got = "human"
            else:
                got = "ours"
            ok = got == want
            failed += not ok
            print("%s %s（期待 %s / 結果 %s）" % ("ok  " if ok else "FAIL", name, want, got))
            os.remove(path)
    finally:
        os.rmdir(tmp)

    # Claude Code が末尾から名前を読み直すときの絞り込みと同じ条件
    line = title_line(sid, '名前 "引用" ／ 段階')
    ok = ('"type":"custom-title"' in line and '"customTitle":"' in line
          and json.loads(line)["customTitle"] == '名前 "引用" ／ 段階')
    failed += not ok
    print("%s 書く行が Claude Code に読み直される書式" % ("ok  " if ok else "FAIL"))
    return failed == 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(0 if self_test() else 1)
    if sys.argv[1:] == ["--hook"]:
        try:
            hook()
        except Exception:  # hook の失敗で会話を止めない
            pass
        return
    command(sys.argv[1:])


if __name__ == "__main__":
    main()
